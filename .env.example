# ==========================================================================
# SAMJONA SMS - Environment Variables
# ==========================================================================
# TWO FILES, FOR TWO DIFFERENT JOBS
# --------------------------------------------------------------------------
#   .env.setup   Privileged database access. Read ONLY by
#                `npm run db:setup`. Next.js never loads it, so the superuser
#                credential is not present in the running application.
#                Section 1 below belongs here.
#
#   .env.local   Application runtime configuration. Read by Next.js and by
#                `npm run db:setup`. Sections 2 onward belong here.
#
# Both are gitignored. NEVER commit real credentials.
# Every value below is a PLACEHOLDER.
#
# **Supabase PostgreSQL is the primary database and source of truth.**
# ==========================================================================


# ==========================================================================
# SECTION 1 - .env.setup : PRIVILEGED DATABASE ACCESS
# ==========================================================================
# Needed to create the login roles and to apply migrations, because those
# require privileges the application role deliberately does not have.
# ==========================================================================

# --------------------------------------------------------------------------
# 1a. ADMIN CONNECTION  (setup and migrations only)
# --------------------------------------------------------------------------
# Supabase Dashboard -> Project -> Connect -> Connection string -> URI.
# Select the "Direct connection" (port 5432) variant. The CLI and this script
# are short-lived and hold at most one connection each, so pooling is
# irrelevant here and the direct connection is the least surprising option.
#
# THIS IS THE SUPERUSER CREDENTIAL. It bypasses every RLS policy in the
# database. Never place it in .env.local, never deploy it, never send it to a
# client.
ADMIN_DATABASE_URL=postgresql://postgres:CHANGE_ME@db.CHANGE_ME.supabase.co:5432/postgres

# --------------------------------------------------------------------------
# 1b. GENERATED ROLE PASSWORDS
# --------------------------------------------------------------------------
# The database roles this application connects as. Migrations deliberately do
# NOT create them: a `create role ... password '...'` inside a versioned file
# is a credential in Git, copied into every clone and every backup, and
# impossible to rotate without editing an applied migration.
#
# Generate each one:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# They must be DIFFERENT from each other and from the database password.
SAMJONA_LOGIN_PASSWORD=CHANGE_ME
SAMJONA_SERVICE_LOGIN_PASSWORD=CHANGE_ME


# ==========================================================================
# SECTION 2 onward - .env.local : APPLICATION RUNTIME
# ==========================================================================

# --------------------------------------------------------------------------
# 2. DATABASE  (REQUIRED)
# --------------------------------------------------------------------------
# Supabase Dashboard -> Project -> Connect -> Connection string.
#
# USE THE TRANSACTION POOLER ON PORT 6543.
#
#   postgresql://samjona_login:<SAMJONA_LOGIN_PASSWORD>@db.<PROJECT_REF>.supabase.co:6543/postgres
#
# Why 6543 and not 5432:
#   * 5432 is the session pooler / direct connection. Vercel functions are
#     serverless, so each invocation may open its own connection and you will
#     exhaust the connection limit within minutes.
#   * 6543 is transaction mode, which is correct because every unit of work
#     in this application runs inside BEGIN/COMMIT.
#
# The user MUST be samjona_login, or another non-owner, non-superuser role that
# is a member of samjona_app. Connecting as `postgres` or as a service-role
# user BYPASSES Row Level Security, which would silently disable every access
# policy in the database.
DATABASE_URL=postgresql://samjona_login:CHANGE_ME@db.CHANGE_ME.supabase.co:6543/postgres

# Maximum pooled connections. Keep small on serverless.
DATABASE_POOL_MAX=5

# Abort any statement that runs longer than this. Protects against a stuck lock.
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Supabase project reference (no .supabase.co suffix).
SUPABASE_PROJECT_REF=CHANGE_ME

# --------------------------------------------------------------------------
# 2. AUTHENTICATION
# --------------------------------------------------------------------------
# Generate with:  openssl rand -base64 32
AUTH_SECRET=replace-with-32-byte-random-base64-string

# Public URL of the deployment.
# Local:      http://localhost:3000
# Production: https://your-app.vercel.app
NEXTAUTH_URL=http://localhost:3000

# --------------------------------------------------------------------------
# 3. SUPABASE CLIENT (optional)
# --------------------------------------------------------------------------
# Only needed if you use the Supabase browser client for auth.
# The ANON key is designed to be public and is safe to expose. It is still
# subject to Row Level Security, which is what protects your data.
#
# NEVER put the service-role key in a NEXT_PUBLIC_ variable. Next.js inlines
# every NEXT_PUBLIC_* value into the JavaScript bundle sent to browsers.
NEXT_PUBLIC_SUPABASE_URL=https://CHANGE_ME.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=CHANGE_ME

# --------------------------------------------------------------------------
# 4. PRIVILEGED SERVICE CONNECTION  (ADVANCED - usually not needed)
# --------------------------------------------------------------------------
# Payroll GENERATION runs as a BYPASSRLS role so that a request handler can
# never write payroll tables directly, no matter what permission check it
# passes. The standard setup achieves this with a second login role
# (`samjona_service_login`) whose credentials are held in a Vercel secret.
#
# Set this ONLY if you are routing the service connection through the
# Supabase JS client instead. It bypasses RLS and must never be exposed.
# SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------------------------------
# 5. CURRENCY  (ASSUMPTION - CONFIRM WITH THE SCHOOL)
# --------------------------------------------------------------------------
# ISO 4217 code. NLe = Sierra Leone Leone.
# All money is stored as an integer number of minor units, never a float.
CURRENCY_CODE=NLe
CURRENCY_MINOR_UNITS=2

# --------------------------------------------------------------------------
# 6. BUSINESS RULES
# --------------------------------------------------------------------------
# Employee statuses included in payroll generation, comma separated.
# Defaults to Active only, so a suspended or terminated employee is never
# paid by accident. The set actually used is also snapshotted onto each
# payroll run.
PAYROLL_ELIGIBLE_EMPLOYEE_STATUSES=active

# Internal control: the user who GENERATES a payroll may not be the sole user
# who APPROVES it. Also enforced by a database CHECK constraint.
REQUIRE_SEPARATE_PAYROLL_APPROVER=true

# --------------------------------------------------------------------------
# 7. FEATURE FLAGS
# --------------------------------------------------------------------------
# Attendance is deliberately OFF. The school must confirm its rules first.
# Never deduct salary for absence without an explicit written policy.
ENABLE_ATTENDANCE_MODULE=false
ENABLE_LEAVE_MODULE=true

# --------------------------------------------------------------------------
# 8. RATE LIMITING
# --------------------------------------------------------------------------
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# --------------------------------------------------------------------------
# 9. ENVIRONMENT
# --------------------------------------------------------------------------
NODE_ENV=development


# ==========================================================================
# NOT REQUIRED ANY MORE
# ==========================================================================
# Google Sheets is no longer the database. There is no spreadsheet id, no
# service-account key, and no GOOGLE_SHEETS_* variable.
#
# Google Sheets may later be used as an OPTIONAL export/reporting target.
# See docs/architecture.md, section "Optional Google Sheets integration".
# ==========================================================================
