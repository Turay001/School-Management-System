# ==========================================================================
# SAMJONA SMS - Privileged setup credentials
# ==========================================================================
# COPY THIS FILE TO `.env.setup` AND FILL IN REAL VALUES, THEN:
#
#   npm run db:setup
#
# `.env.setup` is gitignored and is read ONLY by scripts/db-setup.ts.
# Next.js never loads it, so the superuser password below is not present
# anywhere in the deployed application.
#
# Do NOT put these values in `.env.local`. Next.js loads `.env.local` into
# the running server process, which would put a credential that bypasses all
# Row Level Security within reach of every request handler.
#
# Everything the application itself needs is in `.env.example`.
# ==========================================================================


# --------------------------------------------------------------------------
# ADMIN CONNECTION  (required)
# --------------------------------------------------------------------------
# Supabase -> Project -> Connect -> Connection string -> URI -> "Direct
# connection" (port 5432). Used to create the database roles and to apply
# migrations, neither of which the application role is permitted to do.
#
# This is the project superuser. It bypasses every RLS policy in the database.
ADMIN_DATABASE_URL=postgresql://postgres:CHANGE_ME@db.CHANGE_ME.supabase.co:5432/postgres

# --------------------------------------------------------------------------
# GENERATED ROLE PASSWORDS  (required)
# --------------------------------------------------------------------------
# Passwords for the two login roles the application connects as. Generate a
# different one for each:
#
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# At least 16 characters. The script refuses to run on a placeholder value or
# on a password shorter than that, because a weak database password is a
# worse failure than a setup script that stops.
#
# Password for samjona_login, the RLS-subject application role.
SAMJONA_LOGIN_PASSWORD=CHANGE_ME

# Password for samjona_service_login, the BYPASSRLS role used only by payroll
# generation. Optional until payroll goes live; the script will warn if unset
# rather than inventing a value.
SAMJONA_SERVICE_LOGIN_PASSWORD=CHANGE_ME
