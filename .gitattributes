# Normalise line endings in the repository, not in the working tree.
#
# Without this, Git on Windows checks out CRLF, and every file shows as modified
# after any tool rewrites it with LF. That turns a one-line change into a
# whole-file diff and makes `git diff` useless for review.
#
# `text=auto` lets Git detect text vs binary. The explicit rules below matter for
# the files where a naive auto-detection would be wrong.
* text=auto

# SQL migrations: LF always. These are applied to Postgres through tooling that
# reads bytes; a stray CRLF inside a dollar-quoted function body is a real
# hazard, and these files are the financial record's definition.
*.sql text eol=lf

# Shell scripts must be LF or they fail on Unix with "bad interpreter".
*.sh text eol=lf

# JSON, YAML, Markdown.
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf

# TypeScript and friends: LF in the repository, native in the working tree.
*.ts text
*.tsx text
*.js text
*.mjs text
*.cjs text
*.css text

# Lockfiles are generated; leave them alone entirely.
package-lock.json -text
